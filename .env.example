# Copy to .env.local for local development. In GitHub, add the same two as repository secrets.
# Both values are public by design. Row-level security in the database protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Optional. Set to /REPO-NAME/ only if you prefer an absolute base on GitHub Pages. Default ./ works.
# VITE_BASE=./
